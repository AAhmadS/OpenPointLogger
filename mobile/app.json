{
  "expo": {
    "name": "Trailmark Capture",
    "slug": "trailmark-capture",
    "version": "0.1.0",
    "scheme": "trailmark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ir.chantex.trailmark",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f16"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access photos so screenshots can be attached to points."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.trailmark.chantex.ir/v1",
      "eas": {
        "projectId": "c326f542-ddbc-4f81-8985-4d544343c521"
      }
    },
    "owner": "chantex"
  }
}
