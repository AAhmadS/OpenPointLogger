venv/

# build artifacts
build/
dist/
*.spec
# ...except the one that builds the shipped exe. Without it a fresh
# clone loses the sounddevice hiddenimport and silently builds an exe
# whose voice logging cannot start.
!Trailmark.spec
OpenPointLogger.exe
Trailmark.exe

# local test artifacts
tests/_browser/
tests/*.log
.playwright-mcp/